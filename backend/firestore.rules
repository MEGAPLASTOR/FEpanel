rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() { return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'; }

    // Users
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
      allow create, delete: if isAdmin();
    }

    // Slots
    match /slots/{slotId} {
      allow read: if isAuth() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.ownerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'ramLimit', 'cpuLimit', 'diskLimit', 'containerId', 'serverHost', 'serverPort'])
      );

      // Slot logs - read only for owner, write only from backend
      match /logs/{logId} {
        allow read: if isAuth() && (get(/databases/$(database)/documents/slots/$(slotId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if false;
      }

      // Slot settings
      match /settings/{doc} {
        allow read: if isAuth() && (get(/databases/$(database)/documents/slots/$(slotId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if isAuth() && (get(/databases/$(database)/documents/slots/$(slotId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
